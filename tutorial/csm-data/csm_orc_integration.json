{
  "steps": [
    {
      "id": "download-runner-data",
      "command": "csm-data",
      "arguments": [
        "api", "run-load-data"
      ],
      "useSystemEnvironment": true
    },
    {
      "id": "run-simulation",
      "command": "python",
      "arguments": ["run_simulation.py"],
      "precedents": ["download-runner-data"]
    },
    {
      "id": "send-results-to-adx",
      "command": "csm-data",
      "arguments": [
        "adx-send-runnerdata",
        "--send-datasets",
        "--wait"
      ],
      "useSystemEnvironment": true,
      "precedents": ["run-simulation"]
    }
  ]
}
